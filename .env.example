# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/optimus
# Set to "require" only when the provider supplies a trusted TLS certificate.
DATABASE_SSL=
DB_POOL_MAX=5

# Authentication and encryption (generate independent, random values)
JWT_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64

# Public application URL and password-reset email delivery
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Optimus <no-reply@example.com>
CRON_SECRET=replace-with-a-long-random-value
INTEGRATION_JOB_BATCH=20
NOTIFICATION_SEED_BATCH=80

# Expo push delivery
# Set to false for environments that must never contact Expo.
EXPO_PUSH_ENABLED=true
# Optional. Required only when Expo push security is enabled for the project.
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_BATCH=50
EXPO_PUSH_RECEIPT_BATCH=100

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Exact verified HTTPS Universal Link/App Link. The path is fixed.
MOBILE_GOOGLE_OAUTH_RETURN_URL=
# Exact native app identities used by the root .well-known association files.
MOBILE_APPLE_TEAM_ID=
MOBILE_IOS_BUNDLE_ID=
MOBILE_ANDROID_PACKAGE_NAME=
# Comma-separated Play/App Signing SHA-256 certificate fingerprints.
MOBILE_ANDROID_SHA256_FINGERPRINTS=
