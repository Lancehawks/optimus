# PostgreSQL
# Vercel's POSTGRES_URL is also accepted when DATABASE_URL is not set.
DATABASE_URL=postgresql://user:password@localhost:5432/optimus
# Set to "require" only when the provider supplies a trusted TLS certificate.
DATABASE_SSL=
DB_POOL_MAX=5
# Allow time for a suspended serverless database to wake up.
DB_CONNECTION_TIMEOUT_MS=15000
# Delay before one retry of a terminated database connection.
DB_RETRY_DELAY_MS=200

# Founder Lobby (server-side PIN; never expose this as NEXT_PUBLIC_*)
FOUNDER_LOBBY_PIN=replace-with-a-private-pin

# Authentication and encryption (generate independent, random values)
JWT_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64

# Public application URL and password-reset email delivery
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Optimus <no-reply@example.com>

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Exact verified HTTPS Universal Link/App Link. The path is fixed.
MOBILE_GOOGLE_OAUTH_RETURN_URL=
# Exact native app identities used by the root .well-known association files.
MOBILE_APPLE_TEAM_ID=
MOBILE_IOS_BUNDLE_ID=
MOBILE_ANDROID_PACKAGE_NAME=
# Comma-separated Play/App Signing SHA-256 certificate fingerprints.
MOBILE_ANDROID_SHA256_FINGERPRINTS=

# Assistant (members opt in under Settings → Assistant)
# Server-side only; never expose this as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
# "<provider>:<model>" from src/lib/ai/models.js. New conversations use it;
# existing ones stay on the model they started with.
AI_MODEL=anthropic:claude-haiku-5-5
# Workspace-wide monthly spend cap in US dollars (estimated from token usage).
AI_MONTHLY_BUDGET_USD=10
