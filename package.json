{
  "name": "optimus",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/run-isolated-e2e.mjs",
    "test:db": "node tests/database-integration.mjs",
    "test:permissions": "node --test tests/permission-hardening.test.cjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-database.mjs",
    "db:verify-baseline": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-baseline.mjs",
    "invite": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-invitation.mjs",
    "member:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-member.mjs",
    "tokens:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/manage-google-token-encryption.mjs",
    "tokens:encrypt": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/manage-google-token-encryption.mjs --apply",
    "prod:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-deployment.mjs",
    "verify": "npm run lint && npm test && npm run build && npm audit --omit=dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@blocknote/code-block": "^0.56.0",
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.24.0",
    "next": "16.4.3",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "@radix-ui/react-tabs": "1.1.21",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.93.3"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "mermaid": "11.17.2",
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "baseline-browser-mapping": "2.11.0",
    "dompurify": "3.4.17",
    "katex": "0.18.2",
    "markdown-it": "14.3.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    },
    "points-on-path": "0.2.1",
    "postcss": "^8.5.10",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "js-yaml": "4.3.2",
    "zod": "4.6.7"
  }
}
