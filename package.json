{
  "name": "optimus",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node --env-file-if-exists=.env.local scripts/run-isolated-e2e.mjs",
    "test:db": "node tests/database-integration.mjs",
    "test:permissions": "node --test tests/permission-hardening.test.cjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-database.mjs",
    "db:verify-baseline": "node --env-file-if-exists=.env.local scripts/verify-baseline.mjs",
    "tokens:verify": "node --env-file-if-exists=.env.local scripts/manage-google-token-encryption.mjs",
    "tokens:encrypt": "node --env-file-if-exists=.env.local scripts/manage-google-token-encryption.mjs --apply",
    "prod:verify": "node --env-file-if-exists=.env.local scripts/verify-deployment.mjs",
    "verify": "npm run lint && npm test && npm run build && npm audit --omit=dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@radix-ui/react-tabs": "1.1.21",
    "postcss": "^8.5.10",
    "sharp": "0.35.3"
  }
}
